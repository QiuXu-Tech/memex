{
  "name": "@qiuxu/memex-workspace",
  "version": "0.15.0",
  "private": true,
  "description": "Workspace for memex: the extra-context layer for AI agents \u2014 agent-agnostic context core, DSH bundle, MCP server, Claude Code / Codex adapters, model profiles, offline harness and benchmarks.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build-bundle.mjs",
    "check": "node scripts/check-bundle.mjs",
    "test": "node --import ./test/register.mjs ./test/run.mjs",
    "test:sqlite": "node --import ./test/register.mjs --test ./test/sqlite-consistency.mjs",
    "eval:recall": "node --import ./test/register.mjs ./scripts/recall-eval.mjs --suite all",
    "eval:long-horizon": "node --import ./test/register.mjs ./scripts/long-horizon-eval.mjs --mode compaction --tokens 160000 --window 80000 --out /tmp/lh-compaction",
    "bench:scale": "node --import ./test/register.mjs ./scripts/scale-bench.mjs",
    "backup": "node --import ./test/register.mjs ./scripts/memory-backup.mjs backup",
    "mcp": "node --import ./test/register.mjs ./packages/memex-mcp/bin/server.mjs",
    "claude:init": "node --import ./test/register.mjs ./packages/memex-claude/bin/cli.mjs init",
    "codex:init": "node --import ./test/register.mjs ./packages/memex-codex/bin/cli.mjs init"
  },
  "license": "MIT"
}
