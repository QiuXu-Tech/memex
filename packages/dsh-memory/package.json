{
  "name": "@qiuxu/dsh-memory",
  "version": "0.1.0",
  "private": true,
  "description": "Extra-context memory subsystem bundle: L1 raw eviction, sticky L2/L3 archives with capacity compression (cold tier + bounded batch digests), model retrieval tools, /memory command, owner-authenticated HTTP routes, and a Web memory panel.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./local": "./modules/memory-local/index.js",
    "./checkpoint": "./modules/memory-checkpoint/index.js",
    "./tools": "./modules/memory-tool/index.js",
    "./commands": "./modules/memory-command/index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./api": "./modules/memory-api/index.js",
    "./ui": "./modules/memory-ui/index.js",
    "./evict": "./modules/memory-evict/index.js",
    "./compress": "./modules/memory-compress/index.js"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "modules",
    "locale/*.json",
    "icon.svg"
  ],
  "engines": {
    "dsh": "0.2.1-rc.3"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
